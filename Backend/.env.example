# Copy to .env and fill in values. NEVER commit .env or real secrets to version control.
# Use environment variables on the deployment server or a secrets manager for production.

PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/your-db-name

# JWT / session (use a long random string in production)
SESSION_SECRET=your-secret-here
# JWT_SECRET=optional-override

# API keys - set on server, never commit actual values
GROQ_API_KEY=
MAP_TOKEN=

# Optional: fallback AI (Anthropic-compatible)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://cc.honoursoft.cn/v1
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Frontend origin for CORS (e.g. http://localhost:5173 or your production URL)
# FRONTEND_URL=http://localhost:5173
